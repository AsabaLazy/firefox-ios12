+      // zeroed the whole count, hiding all cameras on iOS 12.)
+      if (@available(iOS 14.0, *)) {
+        if ([device isSuspended]) {
+          continue;
+        }
       }
       if (cnt == index) {
         return device;
@@ -84,8 +84,13 @@ + (AVCaptureDevice*)captureDeviceForUniqueId:(NSString*)uniqueId {
   for (AVCaptureDevice* device in
        [AVCaptureDevice devicesWithMediaType:AVMediaTypeVideo]) {
